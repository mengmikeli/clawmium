# CityServe mock website port
PORT=3000

# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key
OPENAI_API_KEY=sk-...

# LLM token limits (optional — defaults shown)
MAX_TOKENS_INTERPRET=2048
MAX_TOKENS_PLAN=512
MAX_TOKENS_EXTRACT=1024
